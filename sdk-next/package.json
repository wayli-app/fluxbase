{
  "name": "@nimbleflux/fluxbase-sdk-next",
  "version": "2026.7.3-rc.24",
  "description": "Next.js server/client adapters and SSR cookie storage for Fluxbase SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs": "typedoc",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "fluxbase",
    "nextjs",
    "next",
    "ssr",
    "database",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbleflux/fluxbase"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nimbleflux/fluxbase-sdk": "^2026.7.3-rc.24",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@nimbleflux/fluxbase-sdk": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
